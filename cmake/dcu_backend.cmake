# Hygon's DTK supplies the HIP runtime and rocBLAS. Do not search an AMD ROCm installation.
set(STRATA_DTK_ROOT "$ENV{DTKROOT}" CACHE PATH "Hygon DTK installation")
if(NOT STRATA_DTK_ROOT)
  message(FATAL_ERROR "Set STRATA_DTK_ROOT or source the installed DTK env.sh")
endif()
if(NOT EXISTS "${STRATA_DTK_ROOT}/include/hip/hip_runtime.h")
  message(FATAL_ERROR "STRATA_DTK_ROOT does not contain DTK HIP headers")
endif()
if(NOT DEFINED CMAKE_HIP_ARCHITECTURES)
  set(CMAKE_HIP_ARCHITECTURES gfx906 CACHE STRING "Hygon DCU architecture")
endif()
if(NOT CMAKE_HIP_ARCHITECTURES STREQUAL "gfx906")
  message(FATAL_ERROR "The DCU backend currently targets Z100L/gfx906 only")
endif()
if(DEFINED ENV{HSA_OVERRIDE_GFX_VERSION} AND NOT "$ENV{HSA_OVERRIDE_GFX_VERSION}" STREQUAL "")
  message(FATAL_ERROR "Unset HSA_OVERRIDE_GFX_VERSION; the DCU backend uses the actual device architecture")
endif()
set(CMAKE_HIP_COMPILER "${STRATA_DTK_ROOT}/llvm/bin/clang++" CACHE FILEPATH "DTK HIP compiler")
set(CMAKE_HIP_COMPILER_ROCM_ROOT "${STRATA_DTK_ROOT}" CACHE PATH "DTK HIP root")
list(PREPEND CMAKE_PREFIX_PATH "${STRATA_DTK_ROOT}" "${STRATA_DTK_ROOT}/.hyhal")
find_package(amd_comgr CONFIG REQUIRED PATHS
             "${STRATA_DTK_ROOT}/lib64/cmake/amd_comgr"
             "${STRATA_DTK_ROOT}/lib/cmake/amd_comgr" NO_DEFAULT_PATH)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES amd_comgr_DIR CMAKE_PREFIX_PATH)
enable_language(HIP)
find_package(hip CONFIG REQUIRED PATHS "${STRATA_DTK_ROOT}/lib/cmake/hip" NO_DEFAULT_PATH)
find_package(rocblas CONFIG REQUIRED PATHS "${STRATA_DTK_ROOT}/lib/cmake/rocblas" NO_DEFAULT_PATH)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
add_library(strata_dcu_runtime INTERFACE)
set(_strata_gpu_include_directories
    "${CMAKE_CURRENT_SOURCE_DIR}/include/strata/platform/dcu_compat"
    "${CMAKE_CURRENT_SOURCE_DIR}/include/strata/platform/hip_compat")
target_include_directories(strata_dcu_runtime BEFORE INTERFACE ${_strata_gpu_include_directories})
include_directories(BEFORE "${CMAKE_CURRENT_SOURCE_DIR}/include/strata/platform/hip_compat")
include_directories(BEFORE "${CMAKE_CURRENT_SOURCE_DIR}/include/strata/platform/dcu_compat")
target_compile_definitions(strata_dcu_runtime INTERFACE STRATA_USE_DCU=1 STRATA_GPU_WAVE64=1)
target_compile_options(strata_dcu_runtime INTERFACE
                       "$<$<COMPILE_LANGUAGE:HIP>:--gpu-max-threads-per-block=1024>")
add_compile_definitions(STRATA_USE_DCU=1)
target_link_libraries(strata_dcu_runtime INTERFACE hip::host)
set(_strata_gpu_runtime_target strata_dcu_runtime)
set(_strata_gpu_blas_target roc::rocblas)
if(STRATA_BUILD_TESTS)
  add_executable(dcu_blas_selftest tests/dcu/blas.cpp)
  target_link_libraries(dcu_blas_selftest PRIVATE strata_dcu_runtime roc::rocblas)
  enable_testing()
  add_test(NAME dcu_blas_selftest COMMAND dcu_blas_selftest)
  add_executable(dcu_runtime_selftest tests/dcu/runtime.cu)
  set_source_files_properties(tests/dcu/runtime.cu PROPERTIES LANGUAGE HIP)
  target_link_libraries(dcu_runtime_selftest PRIVATE strata_dcu_runtime)
  add_test(NAME dcu_runtime_selftest COMMAND dcu_runtime_selftest)
  add_executable(dcu_prefill_selftest tests/dcu/prefill.cpp)
  target_link_libraries(dcu_prefill_selftest PRIVATE strata_prefill strata_dcu_runtime)
  add_test(NAME dcu_prefill_selftest COMMAND dcu_prefill_selftest)
  add_executable(dcu_resident_plan_selftest tests/dcu/resident_plan.cpp)
  target_link_libraries(dcu_resident_plan_selftest PRIVATE strata_kernels strata_dcu_runtime)
  add_test(NAME dcu_resident_plan_selftest COMMAND dcu_resident_plan_selftest)
endif()
message(STATUS "Strata: Hygon DCU, native DTK ${STRATA_DTK_ROOT}, gfx906 wave64, rocBLAS")
if(STRATA_BUILD_TESTS)
  add_executable(dcu_mapped_combine_selftest tests/dcu/mapped_combine.cpp)
  target_link_libraries(dcu_mapped_combine_selftest PRIVATE strata_kernels strata_dcu_runtime)
  add_test(NAME dcu_mapped_combine_selftest COMMAND dcu_mapped_combine_selftest)
endif()
